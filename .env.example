VITE_APP_URL=http://localhost:5173
GROQ_API_KEY=your_groq_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
PAGESPEED_API_KEY=optional_pagespeed_api_key
GROQ_DAILY_LIMIT=14400
FIRECRAWL_DAILY_LIMIT=500
ROAST_V11_ENABLED=1
PRO_TIER_ENABLED=1
UPSTASH_REDIS_REST_URL=your_upstash_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is not used by Vite client builds.
# Keep it only if you also run a Next.js surface elsewhere.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_JWT_ISSUER=optional_expected_clerk_jwt_issuer
ADMIN_EMAILS=pranvgg@gmail,pranvgg@gmail.com
